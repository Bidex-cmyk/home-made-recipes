rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read any profile, only write their own
    match /users/{userId} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
    // Recipes: anyone can read, only author can write
    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }
    // Reviews/ratings per recipe
    match /recipes/{recipeId}/reviews/{reviewId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.userId == request.auth.uid;
    }
    // Comments (recipes - legacy)
    match /recipes/{recipeId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.authorId == request.auth.uid;
    }
    // Comments for posts (P1-B1)
    match /posts/{postId}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() < 500;
      allow update, delete: if request.auth != null
                            && resource.data.authorId == request.auth.uid;
    }
    // I Cooked This / cooks — id must be uid, no faking, allow update for caption edit
    match /recipes/{recipeId}/cooks/{cookId} {
      allow read: if true;
      allow create: if request.auth != null
                    && cookId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
                    && cookId == request.auth.uid
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if request.auth != null
                    && cookId == request.auth.uid
                    && resource.data.userId == request.auth.uid;
    }
    // Saved recipes: user-scoped
    match /users/{userId}/savedRecipes/{recipeId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Shopping list (Spark): per-item docs users/{uid}/shoppingList/{itemId} + single doc mealPlan/current
    match /users/{userId}/shoppingList/{itemId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/mealPlan/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Legacy plural paths kept for backward compat (not used by new code)
    match /users/{userId}/shoppingLists/{listId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /users/{userId}/mealPlans/{planId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    // Posts: read public, write owner
    match /posts/{postId} {
      allow read: if true;
      // Privacy (P0 #7): new posts must NOT contain authorEmail — public posts must not expose emails.
      // Create-only constraint: legacy docs without it can still be edited by their author.
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid
                    && !('authorEmail' in request.resource.data.keys());
      allow update, delete: if request.auth != null
                            && resource.data.authorId == request.auth.uid;
    }
    match /posts/{postId}/likes/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    // Follows — deterministic ID followerId_followingId, no self-follow, no impersonation
    match /follows/{followId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.followerId == request.auth.uid
                    && request.resource.data.followingId is string
                    && request.resource.data.followingId.size() > 0
                    && request.resource.data.followerId != request.resource.data.followingId
                    && followId == request.resource.data.followerId + "_" + request.resource.data.followingId;
      allow delete: if request.auth != null
                    && resource.data.followerId == request.auth.uid;
    }
    // Messages — private, deterministic 1-1 conversations, Spark (no Storage)
    match /conversations/{convId} {
      // Helper: deterministic ID must be smallerUid_largerUid
      allow create: if request.auth != null
                    && request.resource.data.participants is list
                    && request.resource.data.participants.size() == 2
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants[0] != request.resource.data.participants[1]
                    && convId == (request.resource.data.participants[0] < request.resource.data.participants[1] ? request.resource.data.participants[0] + "_" + request.resource.data.participants[1] : request.resource.data.participants[1] + "_" + request.resource.data.participants[0]);
      // resource is null when the doc does not exist yet. Without the null guard the
      // client's getDoc() existence check (before create) is denied with permission-denied,
      // which made it impossible to start any new conversation. Nothing is exposed here:
      // an existing conversation is still only readable by its participants.
      allow read: if request.auth != null
                  && (resource == null || request.auth.uid in resource.data.participants);
      // Only participants can update lastMessage/updatedAt, never participants array
      allow update: if request.auth != null
                    && request.auth.uid in resource.data.participants
                    && request.auth.uid in request.resource.data.participants
                    && request.resource.data.participants == resource.data.participants;
      // No delete for now
      match /messages/{msgId} {
        allow read: if request.auth != null
                    && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants;
        allow create: if request.auth != null
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convId)).data.participants
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() < 1000;
        // Users can only delete their own messages (optional)
        allow delete: if request.auth != null
                      && resource.data.senderId == request.auth.uid;
      }
    }
    // Lifestyle — private user-owned (My Lifestyle), no Storage, URL-based images
    match /users/{userId}/lifestyle/{itemId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.caption is string
                    && request.resource.data.caption.size() > 0
                    && request.resource.data.caption.size() < 1000;
      allow update, delete: if request.auth != null
                            && request.auth.uid == userId
                            && resource.data.ownerId == request.auth.uid;
    }
    // My Videos — private URL-based (Spark, no Storage uploads)
    match /users/{userId}/videos/{videoId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() < 200
                    && request.resource.data.videoUrl is string
                    && request.resource.data.videoUrl.size() > 0
                    && request.resource.data.videoUrl.matches('https?://.*');
      allow update, delete: if request.auth != null
                            && request.auth.uid == userId
                            && resource.data.ownerId == request.auth.uid;
    }
    // Videos: public read, owner write (legacy community videos)
    match /videos/{videoId} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null
                            && resource.data.authorId == request.auth.uid;
    }
    // Notifications: recipient only
    match /users/{userId}/notifications/{notifId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
