# Firebase Web Config — safe to expose (client-side), but keep per-environment separate.
# Copy to .env.local for local dev. Never commit .env.local with real keys.
# For Hosting auto-config (recommended), leave these empty — app will fetch /__/firebase/init.json when hosted on Firebase Hosting.

# Common (used only when NOT on Firebase Hosting, e.g. localhost file:// or custom domain without auto-init)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Environment hint — used for UI badge and to prevent accidental demoMode in prod
# Values: development | staging | production
VITE_ENV=development

# Demo mode force (only for local). If true, uses localStorage seed data even if config is present.
VITE_DEMO_MODE=false
